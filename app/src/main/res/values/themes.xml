<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Kot1_Pokedex" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">#F5F6FA</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Kot1_Pokedex" parent="Base.Theme.Kot1_Pokedex" />

    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
